# Vorlage: kopieren nach .env und ausfüllen. Die .env nie in Git einchecken.

# --- Datenbank ---
# Server (Docker): nur das Passwort setzen, DATABASE_URL baut docker compose selbst.
POSTGRES_PASSWORD=bitte-aendern
# Lokale Entwicklung ohne Docker:
DATABASE_URL=postgresql://postgres@localhost:5432/gassi

# --- Sicherheit ---
# Schlüssel zum Verschlüsseln der gespeicherten Tractive-Tokens. Einmal erzeugen und nie ändern
# (sonst müssen sich alle neu anmelden):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=
# Nur lokal ohne HTTPS:
# COOKIE_SECURE=false

# --- Karte (MapTiler, https://cloud.maptiler.com/account/keys/) ---
MAPTILER_KEY=
# streets-v2, outdoor-v2, basic-v2, topo-v2, hybrid ...
MAPTILER_STIL=streets-v2

# --- Abgleich ---
# Zeitzone für Tagesgrenzen und den Abruf um 23:55
APP_TIMEZONE=Europe/Berlin
# alle wie viele Minuten neue Positionen geholt werden
SYNC_MINUTEN=15
